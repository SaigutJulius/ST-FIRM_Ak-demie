# ── ST-Firm Akädemie Admin Backend — environment config ──
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# Login credentials for the admin dashboard (seeded on first run)
ADMIN_USER=saigut
ADMIN_PASSWORD=change-this-to-a-strong-password

# Secret used to sign login tokens (JWT). Use a long random string.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-secret

# Which website origin is allowed to read the gallery API (CORS).
# Your live site:
ALLOWED_ORIGIN=https://saigutjulius.github.io

# Public URL of THIS backend once deployed (used to build absolute image links).
# Leave blank for local testing. After deploy, e.g.:
# PUBLIC_BASE=https://st-firm-akademie.onrender.com
PUBLIC_BASE=
